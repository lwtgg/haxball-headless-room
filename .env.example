# Copy this file to .env and fill it in.

# Get a fresh one at https://www.haxball.com/headlesstoken before every start.
HAXBALL_TOKEN=

ROOM_NAME=My Futsal 4v4 ⚽
MAX_PLAYERS=30
PUBLIC=true

# Name of the bot shown in the spectator list. Leave empty for no bot player.
BOT_NAME=BOT

# Optional location spoof. LEAVE EMPTY to report where you actually are.
# Setting this wrong makes the room look far away to everyone, including you.
GEO_CODE=
GEO_LAT=
GEO_LON=

MAP_FILE=futsal4v4.hbs
TEAM_SIZE=4
SCORE_LIMIT=3
TIME_LIMIT=3

# Seconds a captain gets per pick before losing the room
PICK_SECONDS=30
# Idle seconds before a player on the pitch is KICKED FROM THE ROOM, and how
# many seconds of idling before that they get a warning. Only counts during a
# match. They can rejoin from the same link immediately.
AFK_SECONDS=20
AFK_WARN_SECONDS=12
# How long a captain's !pausa window stays open for a substitution
PAUSE_SECONDS=15
# Pause before the bot rebuilds teams after a match
REBUILD_DELAY_MS=1500
# Pause in the lobby after a match before the next one starts
LOBBY_PAUSE_MS=6000
# Set to 1 to log the full team/queue state on every rebuild
DEBUG_TEAMS=0
# How often the bot re-checks that teams match reality (ms)
RECONCILE_MS=4000
# How long to wait for a queued stopGame() to land before swapping the map
STOP_SETTLE_MS=250
# How long after applying a line-up to verify it really took effect
CONFIRM_DELAY_MS=400
# Gap between attempts to position a player who joined mid-match
SPAWN_RETRY_MS=120
# Restart the match immediately when a bigger mode needs a different pitch (0 = wait)
INSTANT_MODE_SWITCH=1
MODE_SWITCH_COOLDOWN_MS=20000
# Repeated status messages are only announced once per this many ms
REPEAT_QUIET_MS=90000

# Chat flood protection. Only repeated messages are blocked — say the same
# thing this many times and the next one is swallowed for a few seconds.
SPAM_REPEAT_LIMIT=3
SPAM_COOLDOWN_MS=5000
SPAM_REPEAT_WINDOW_MS=30000

# Goal celebration: how much the scorer's and assister's discs swell, and for
# how long.
CELEBRATION_SCORER_SCALE=3
CELEBRATION_ASSIST_SCALE=1.9
CELEBRATION_MS=4000

COIN_NAME=zicoins
BET_WINDOW_SECONDS=45
# Maximum single bet
BET_MAX=500

ADMIN_PASSWORD=pick-something-strong
# Auth hashes that get admin automatically. Type !auth in the room to find yours.
ADMIN_AUTHS=
DISCORD_LINK=https://discord.gg/yourinvite
